# WHOOP OAuth credentials (from WHOOP Developer Portal)
WHOOP_CLIENT_ID=your_client_id_here
WHOOP_CLIENT_SECRET=your_client_secret_here
WHOOP_REDIRECT_URI=https://your-app.railway.app/oauth/whoop/callback

# Server API key (generate a secure random string)
# Used to protect MCP and cron endpoints
SERVER_API_KEY=your_secure_api_key_here

# App base URL (your Railway domain)
APP_BASE_URL=https://your-app.railway.app

# Optional settings
# DB_PATH=./data/whoop.db
# NODE_ENV=production
# CACHE_TTL_MINUTES=15
# LOG_LEVEL=info
